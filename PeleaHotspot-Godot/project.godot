; Proyecto de pelea LAN - Godot 4.4+
config_version=5

[application]
config/name="Pelea Hotspot"
run/main_scene="res://escenas/MenuPrincipal.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]
NetworkManager="*res://scripts/NetworkManager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
; OpenGL 3 / WebGL 2: máxima compatibilidad para móviles y GPUs antiguas.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[gui]
theme/default_font_multichannel_signed_distance_field=true

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
block={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71)]}
p2_move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74)]}
p2_move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76)]}
p2_jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}
p2_attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":79)]}
p2_block={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80)]}
