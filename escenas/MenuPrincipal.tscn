[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/MenuPrincipal.gd" id="1_menu"]

[node name="MenuPrincipal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.13, 1)
mouse_filter = 2

[node name="Panel" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 390.0
offset_top = 145.0
offset_right = 890.0
offset_bottom = 580.0
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Panel"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "PELEA HOTSPOT"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Panel"]
layout_mode = 2
text = "1 contra 1 · LAN / hotspot"
horizontal_alignment = 1

[node name="Separator" type="HSeparator" parent="Panel"]
layout_mode = 2

[node name="CreateButton" type="Button" parent="Panel"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Crear partida"

[node name="IPInput" type="LineEdit" parent="Panel"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "IP del host (ej.: 192.168.1.10)"

[node name="JoinButton" type="Button" parent="Panel"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "Unirse a partida"

[node name="LocalButton" type="Button" parent="Panel"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
text = "Jugar local (mismo teclado)"

[node name="StatusLabel" type="Label" parent="Panel"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
horizontal_alignment = 1

[node name="QuitButton" type="Button" parent="Panel"]
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
text = "Salir"

[connection signal="pressed" from="Panel/CreateButton" to="." method="_on_create_pressed"]
[connection signal="pressed" from="Panel/JoinButton" to="." method="_on_join_pressed"]
[connection signal="pressed" from="Panel/LocalButton" to="." method="_on_local_pressed"]
[connection signal="pressed" from="Panel/QuitButton" to="." method="_on_quit_pressed"]
